# ============================================================================
# MetricMind 环境变量示例。复制为 backend/.env 或仓库根 .env 后填写。
# 后端启动时同时读取仓库根 .env 与 backend/.env（后者优先）。
# 不含任何真实密钥；.env 已被 .gitignore 忽略，切勿提交。
# ============================================================================

# --- LLM ---
# 任意 OpenAI 兼容服务均可：OpenAI / DeepSeek / Moonshot / 通义 / 本地 vLLM。
OPENAI_API_KEY=
# 例：https://api.deepseek.com/v1 或 http://127.0.0.1:8000/v1
OPENAI_BASE_URL=https://api.openai.com/v1
# 例：gpt-4o-mini / deepseek-chat，不硬编码，由这里决定
LLM_MODEL=gpt-4o-mini
# auto = 有 Key 走 live，无 Key 走 demo；live = 强制真实模型；demo = 无模型脚本化
LLM_MODE=auto
# 单次 LLM 请求超时（秒）与最大重试次数（指数退避 0.5s/1.5s/4s）
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
# 单次输出上限：计划/报告是长 JSON，太小会被截断
LLM_MAX_OUTPUT_TOKENS=4096

# --- 存储 ---
# 相对路径按仓库根解析
DATA_DIR=backend/data
DB_PATH=backend/data/metricmind.db

# --- 限额 ---
MAX_UPLOAD_MB=25
MAX_ROWS=200000
MAX_COLUMNS=60
MAX_STEPS=10
MAX_TOOL_CALLS=16
MAX_REPLANS=2
RUN_TIMEOUT_S=240
MAX_CONCURRENT_RUNS=2
RATE_LIMIT_PER_MINUTE=6

# --- 前端（Vite）---
VITE_API_BASE=/api
